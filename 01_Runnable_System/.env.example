# Preferred public market-data provider: eodhd or yahoo
PUBLIC_DATA_PROVIDER=eodhd

# Keep the real token only in .env or the deployment environment.
EODHD_API_TOKEN=

# Paid EOD Historical Data plan: 0 means no application-level per-run limit.
# EODHD's own account quota still applies.
EODHD_MAX_CALLS_PER_RUN=0
# EODHD does not expose the Tokyo exchange to the current paid account.
# Keep Yahoo only for the exact Tokyo-listed securities; all EODHD-supported
# securities fail closed to cache instead of silently switching provider.
PUBLIC_DATA_TOKYO_YAHOO_EXCEPTION=true

# One-time migration control. Set true only to rebuild all price histories
# from their approved providers, then return it to false for incremental runs.
PUBLIC_DATA_FORCE_FULL_REFRESH=false

# Optional comma-separated internal tickers to prioritize, for example:
# EODHD_TICKERS=VTI,AGG,GLD,BIL,EWJ,EWH,ASHR
