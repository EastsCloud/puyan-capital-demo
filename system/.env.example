NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8790
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://isater:isater_local_only@localhost:5432/isater
SESSION_COOKIE_NAME=isater_session
SESSION_IDLE_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30
APP_TIMEZONE=Asia/Hong_Kong
FRED_API_KEY=
# Optional protected deployment secret. On a fresh database, the API encrypts and enables this EODHD token automatically.
EODHD_API_TOKEN=
# Required in production before an external API token can be stored. Use at least 32 random characters.
EXTERNAL_CREDENTIAL_ENCRYPTION_KEY=
# Demo environments only. Enables an authenticated administrator to clear business records while preserving users and configuration.
ENABLE_DEMO_RESET=false
# Production only: serve apps/web/dist from the API process.
SERVE_WEB=false
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
