{
  "name": "@isater/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "dev:database": "tsx src/dev-database.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "bootstrap-admin": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.2",
    "@isater/domain": "workspace:*",
    "argon2": "^0.43.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^22.15.32",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
